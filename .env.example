# Archive Manager - Environment Variables
# ========================================
# Copy this file to .env and fill in the values.
# This file is tracked in git as a template. The .env file is not.
#
# All variables use the APP_ prefix.
# Use __ (double underscore) as nested delimiter for grouped settings.
#
# Examples:
#   APP_DEBUG=true
#   APP_ENVIRONMENT=production
#   APP_DATABASE__URL=sqlite:///data/db/archive-manager.sqlite
#   APP_DATABASE__ECHO=false
#   APP_LOGGING__LEVEL=WARNING

# External API keys (for future integrations)
# APP_EXTERNAL_API_KEY=
# APP_EXTERNAL_API_SECRET=
